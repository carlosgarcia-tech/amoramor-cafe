---
// Página principal. La vitrina 2.5D es el corazón del scroll;
// los datos vivos llegan de Supabase desde el navegador.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ParallaxSection from '../components/ParallaxSection.astro';
import TransicionPoema from '../components/TransicionPoema.astro';
import MenuSection from '../components/MenuSection.astro';
import PromosSection from '../components/PromosSection.astro';
import BranchesSection from '../components/BranchesSection.astro';
import AdminModal from '../components/AdminModal.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<Navbar />
	<main>
		<Hero />
		<ParallaxSection />
		<TransicionPoema />
		<MenuSection />
		<PromosSection />
		<BranchesSection />
	</main>
	<Footer />
	<AdminModal />
</Layout>
