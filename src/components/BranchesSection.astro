---
// Sucursales (spec §6: tabla `branches` — name, address, schedule, status).
---

<section id="sucursales" class="bg-brand-warmIvory py-20">
	<div class="mx-auto max-w-6xl px-6">
		<h2 class="font-serif text-center text-3xl font-extrabold text-brand-chocolate sm:text-4xl">
			Ven a <span class="text-brand-red">amarnos</span>
		</h2>
		<p class="text-brand-caramel font-cursive mt-1 mb-10 text-center text-2xl">cada sucursal tiene su poema</p>
		<div id="branches-list" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-2 xl:grid-cols-3">
			<p class="col-span-full text-center font-sans text-brand-chocolate/60">Buscando sucursales…</p>
		</div>
	</div>
</section>

<script>
	import { supabase } from '../lib/supabase.js';
	import { esc } from '../lib/esc.js';

	type Branch = {
		id: string;
		name: string;
		address: string;
		phone: string | null;
		schedule: string;
		map_url: string | null;
		status: string;
		has_wifi: boolean;
		is_pet_friendly: boolean;
	};

	const list = document.querySelector('#branches-list')!;

	function mapaEmbed(b: Branch): string {
		const q = encodeURIComponent(`${b.name}, ${b.address}`);
		return `https://maps.google.com/maps?q=${q}&z=16&ie=UTF8&output=embed`;
	}

	function tarjeta(b: Branch): string {
		const estado = b.status === 'active' ? '● Abierta' : b.status === 'upcoming' ? '● Próximamente' : '● Cerrada';
		const clases = b.status === 'active'
			? 'bg-green-100 text-green-700'
			: b.status === 'upcoming'
				? 'bg-brand-gold/20 text-brand-caramel'
				: 'bg-brand-rose/30 text-brand-darkRed';
		const destino = encodeURIComponent(`${b.name}, ${b.address}`);
		const comoLlegar = `https://www.google.com/maps/dir/?api=1&destination=${destino}`;
		return `
			<article class="rounded-3xl bg-brand-cream border border-brand-rose/40 p-6 shadow-md flex flex-col gap-4">
				<div class="flex items-center justify-between">
					<h3 class="font-serif text-xl font-bold text-brand-chocolate">${esc(b.name)}</h3>
					<span class="font-sans text-xs font-bold px-2.5 py-1 rounded-full ${clases}">${estado}</span>
				</div>
				<p class="mt-2 text-sm text-brand-chocolate/70"><i class="fa-solid fa-location-dot text-brand-red mr-1"></i>${esc(b.address)}</p>
				${b.phone ? `<p class="font-sans mt-1 text-sm text-brand-chocolate/70"><i class="fa-solid fa-phone text-brand-red mr-1"></i><a href="tel:${esc(b.phone.replace(/\s+/g, ''))}" class="hover:text-brand-red transition-colors">${esc(b.phone)}</a></p>` : ''}
				<p class="font-sans mt-1 text-sm font-bold text-brand-chocolate"><i class="fa-regular fa-clock text-brand-caramel mr-1"></i>${esc(b.schedule)}</p>
				<div class="mt-3 flex flex-wrap items-center gap-2 font-sans text-xs font-bold">
					${b.has_wifi ? `<span class="rounded-full bg-brand-rose/25 text-brand-darkRed px-2.5 py-1"><i class="fa-solid fa-wifi mr-1"></i>WiFi</span>` : ''}
					${b.is_pet_friendly ? `<span class="rounded-full bg-brand-rose/25 text-brand-darkRed px-2.5 py-1"><i class="fa-solid fa-paw mr-1"></i>Pet Friendly</span>` : ''}
				</div>
				<iframe title="Mapa ${esc(b.name)}" src="${mapaEmbed(b)}" width="100%" height="200" loading="lazy" class="mt-2 w-full rounded-2xl border border-brand-rose/40" referrerpolicy="no-referrer-when-downgrade"></iframe>
				<div class="mt-2 flex flex-wrap items-center gap-3">
					<a href="${comoLlegar}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-brand-red px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-brand-darkRed">
						<i class="fa-solid fa-diamond-turn-right"></i>Cómo llegar
					</a>
					<a href="https://www.google.com/maps/search/?api=1&query=${destino}" target="_blank" rel="noopener" class="text-xs font-bold text-brand-chocolate/60 underline decoration-2 underline-offset-4 transition hover:text-brand-red">Abrir en Google Maps</a>
				</div>
			</article>
		`;
	}

	try {
		const { data, error } = await supabase
			.from('branches')
			.select('id, name, address, phone, schedule, map_url, status, has_wifi, is_pet_friendly')
			.order('name');

		if (error) throw error;
		const branches = (data as Branch[]) ?? [];
		list.innerHTML = branches.length
			? branches.map(tarjeta).join('')
			: '<p class="col-span-full text-center text-brand-chocolate/60">Aún no hay sucursales registradas. ♥</p>';
	} catch (err) {
		list.innerHTML = '<p class="col-span-full text-center text-brand-chocolate/60">No pude cargar las sucursales — revisa las claves de Supabase.</p>';
		console.error('[branches]', err);
	}
</script>
